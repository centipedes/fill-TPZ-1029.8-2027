from pypdf import PdfReader, PdfWriter
from reportlab.lib.pagesizes import letter
from reportlab.pdfgen import canvas
import io
from pathlib import Path

# Get the project directory 
script_dir = Path(__file__).parent

file_name = "ACTCA-2027.pdf"
signature_image_path = script_dir / "signature.png"

packet = io.BytesIO()
canv = canvas.Canvas(packet, pagesize=letter)
canv.drawImage(str(signature_image_path), 80, 235, width=120, height=40, mask='auto')

canv.save()

packet.seek(0)
signature_pdf = PdfReader(packet)

for file in script_dir.glob(file_name):
    base_reader = PdfReader(file)
    writer = PdfWriter()

    writer.append(base_reader) 
    writer.pages[0].merge_page(signature_pdf.pages[0])  # Stamp the signature onto the writer's copy 

    # Save your new "base" template that now includes the signature
    output_path = script_dir / f"signed_{file.name}"
    with open(output_path, "wb") as f:
        writer.write(f)
